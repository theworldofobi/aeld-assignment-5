#!/bin/sh

case "$1" in
  start)
    echo "Loading ldd scull and misc-modules"
    scull_load
    module_load faulty
    modprobe hello
    ;;
  stop)
    echo "Unloading ldd scull and misc-modules"
    scull_unload
    module_unload faulty
    rmmod hello
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
